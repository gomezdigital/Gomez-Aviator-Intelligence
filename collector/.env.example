# Copy these settings into your backend host's environment settings.
# Never commit real secrets to GitHub.

PORT=8080
DATA_FILE=./data/rounds.jsonl
# Use long random values from your hosting provider's secret manager.
INGEST_API_TOKEN=replace-with-a-long-random-ingest-secret
READ_API_TOKEN=replace-with-a-different-long-random-read-secret
# Comma-separated exact origins allowed to read data from the dashboard.
CORS_ORIGINS=https://gomezdigital.github.io
# Keep empty until a source's collection method is documented and authorized.
# Example only, not proof of a connected feed: ALLOWED_SOURCES=betway,sportybet
ALLOWED_SOURCES=
